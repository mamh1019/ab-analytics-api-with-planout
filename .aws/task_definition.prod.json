{
    "containerDefinitions": [
        {
            "name": "ab-analytics-api-container",
            "image": "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/your-repo/ab-analytics-api:prod",
            "cpu": 1792,
            "memory": 3584,
            "portMappings": [
                {
                    "name": "fastapi-port",
                    "containerPort": 8001,
                    "hostPort": 8001,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "env",
                    "value": "prod"
                }
            ],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ab-analytics-api-task",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        },
        {
            "name": "datadog-agent",
            "image": "public.ecr.aws/datadog/agent:latest",
            "cpu": 256,
            "memory": 512,
            "essential": true,
            "secrets": [
                {
                    "name": "DD_API_KEY",
                    "valueFrom": "arn:aws:ssm:ap-northeast-2:YOUR_AWS_ACCOUNT_ID:parameter/YourDatadogAPIKey"
                }
            ],
            "environment": [
              {
                "name": "DD_SITE",
                "value": "YOUR_DATADOG_SITE"
              },
              {
                "name": "ECS_FARGATE",
                "value": "true"
              }
            ]
        }
    ],
    "family": "ab-analytics-api-task",
    "taskRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "2048",
    "memory": "4096",
    "ephemeralStorage": {
        "sizeInGiB": 21
    },
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "tags": [
        {
            "key": "createdByProject",
            "value": "ab-analytics-receiver-api"
        },
        {
            "key": "env",
            "value": "prod"
        }
    ]
}